# 환경 변수 예시 파일 -> 실제 환경 변수는 .env 파일에 작성합니다

# 개발 DB — 각자 본인 Neon 연결 문자열을 .env 에 넣습니다
# sslmode=verify-full: 인증서와 호스트 이름을 모두 확인한다(pg 8은 require도 이렇게 처리하지만 경고를 내고, pg 9부터 require는 확인을 하지 않는다)
DATABASE_URL="postgresql://<user>:<password>@<host>.neon.tech/neondb?sslmode=verify-full&channel_binding=require"

# 서비스 기본 URL (초대 링크 만들 때 사용)
NEXT_PUBLIC_BASE_URL="http://localhost:3000"

# 카카오 (발급 후 채움)
KAKAO_REST_API_KEY=""
KAKAO_SKILL_SECRET=""

# 네이버 지도 (발급 후 채움)
NAVER_MAP_CLIENT_ID=""
NAVER_MAP_CLIENT_SECRET=""

# 마이그레이션용 직접 연결 주소(-pooler 없음). 비워두면 DATABASE_URL을 사용. 채울 때도 sslmode=verify-full
DIRECT_URL=""